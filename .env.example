# Documentation only: set process environment explicitly. No automatic .env loader.
# Feature stays off by default; APP_MODE retains its foundation meaning.
INVESTIGATION_ENABLED=false
INVESTIGATION_PROVIDER=test
INVESTIGATION_SOURCE=fixture
INVESTIGATION_STORE=data/processed/investigations.sqlite
INVESTIGATION_ANALYST=local-demo-analyst
# Private backend values only. For provider=openai supply an actual explicit ID.
# No ID/access has been verified; no model-name inference or fallback.
OPENAI_MODEL=
OPENAI_API_KEY=
# Integer overrides may be smaller positive values; these are hard ceilings.
INVESTIGATION_MAX_PROVIDER_REQUESTS=8
INVESTIGATION_MAX_TOOL_CALLS=12
INVESTIGATION_TOTAL_TIMEOUT_SECONDS=120
INVESTIGATION_REQUEST_TIMEOUT_SECONDS=30
# Input/response limits are bytes (input UTF-8); output is token count.
INVESTIGATION_MAX_INPUT_BYTES=48000
INVESTIGATION_MAX_OUTPUT_TOKENS=4096
INVESTIGATION_MAX_RESPONSE_BYTES=2097152
# No SDK, provider probe, corpus loading or SQLite creation during configuration.
