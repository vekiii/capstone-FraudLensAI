{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FraudLens Capstone EV phase record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "commit", "package_version", "rows"],
  "properties": {
    "schema_version": {"const": 1},
    "phase": {"enum": ["baseline", "final"]},
    "commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "package_version": {"$ref": "#/$defs/text"},
    "rows": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"$ref": "#/$defs/row"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "optional_text": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0},
    "trace": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "source_mode", "snapshot_ref", "context_revision"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^(?:CASE-[0-9]{3}|C[0-9a-f]{32})$"},
        "source_mode": {"enum": ["fixture", "dataset"]},
        "snapshot_ref": {"$ref": "#/$defs/text"},
        "context_revision": {"$ref": "#/$defs/sha256"},
        "transaction_id": {"$ref": "#/$defs/text"},
        "dataset_version": {"$ref": "#/$defs/text"},
        "scorer_version": {"$ref": "#/$defs/text"},
        "score_source": {"$ref": "#/$defs/text"},
        "score_kind": {"$ref": "#/$defs/text"},
        "run_id": {"type": "string", "pattern": "^inv_[0-9a-f]{32}(?![\\s\\S])"},
        "attempt_id": {"type": "string", "pattern": "^att_[0-9a-f]{32}$"},
        "report_id": {"$ref": "#/$defs/sha256"},
        "review_id": {"type": "string", "pattern": "^rev_[0-9a-f]{32}$"},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^ev_[0-9a-f]{32}$"}
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_sha256", "corpus", "retrieval", "prompt", "requested_model", "returned_model"],
      "properties": {
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "corpus": {"$ref": "#/$defs/optional_text"},
        "retrieval": {"$ref": "#/$defs/optional_text"},
        "prompt": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "requested_model": {"$ref": "#/$defs/optional_text"},
        "returned_model": {"$ref": "#/$defs/optional_text"}
      }
    },
    "metering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reservations", "confirmed_requests", "unknown_outcomes", "local_rejections", "simulated_requests", "usage"],
      "properties": {
        "reservations": {"$ref": "#/$defs/count"},
        "confirmed_requests": {"$ref": "#/$defs/count"},
        "unknown_outcomes": {"$ref": "#/$defs/count"},
        "local_rejections": {"$ref": "#/$defs/count"},
        "simulated_requests": {"$ref": "#/$defs/count"},
        "usage": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["requests_with_usage", "input_tokens", "output_tokens"],
          "properties": {
            "requests_with_usage": {"type": "integer", "minimum": 1},
            "input_tokens": {"$ref": "#/$defs/count"},
            "output_tokens": {"$ref": "#/$defs/count"}
          }
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "outcome", "trace", "binding", "metering"],
      "properties": {
        "reason": {"$ref": "#/$defs/text"},
        "outcome": {"$ref": "#/$defs/text"},
        "trace": {"$ref": "#/$defs/trace", "minItems": 1},
        "binding": {"anyOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]},
        "metering": {"$ref": "#/$defs/metering"}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "input_sha256", "seed_sha256", "status", "outcome", "reason", "trace", "binding", "versions", "metering", "retries"],
      "properties": {
        "id": {"type": "string", "pattern": "^EV-(?:0[1-9]|1[0-6])$"},
        "mode": {"enum": ["live", "deterministic"]},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "seed_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["pass", "fail", "blocked", "not_run"]},
        "outcome": {"$ref": "#/$defs/optional_text"},
        "reason": {"$ref": "#/$defs/optional_text"},
        "trace": {"$ref": "#/$defs/trace"},
        "binding": {"anyOf": [{"$ref": "#/$defs/binding"}, {"type": "null"}]},
        "versions": {"$ref": "#/$defs/versions"},
        "metering": {"anyOf": [{"$ref": "#/$defs/metering"}, {"type": "null"}]},
        "retries": {"type": "array", "items": {"$ref": "#/$defs/retry"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["pass", "fail"]}}},
          "then": {"properties": {
            "outcome": {"$ref": "#/$defs/text"},
            "trace": {"minItems": 1},
            "metering": {"$ref": "#/$defs/metering"}
          }}
        },
        {
          "if": {"properties": {"status": {"const": "pass"}}},
          "then": {"properties": {"reason": {"type": "null"}}},
          "else": {"properties": {"reason": {"$ref": "#/$defs/text"}}}
        },
        {
          "if": {"properties": {"status": {"const": "not_run"}}},
          "then": {"properties": {
            "outcome": {"type": "null"},
            "metering": {"type": "null"},
            "trace": {"maxItems": 0},
            "retries": {"maxItems": 0}
          }}
        }
      ]
    }
  }
}
