{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fraudlens.example/contracts/data-risk-v1",
  "title": "FraudLens Feature 002 proposal contracts",
  "$defs": {
    "Error": {
      "type": "object", "additionalProperties": false,
      "properties": {"error": {"type": "object", "additionalProperties": false,
        "properties": {"code": {"enum": ["invalid_request", "transaction_not_found", "transaction_ineligible", "model_unavailable", "results_unavailable", "evaluation_not_authorized", "dataset_unavailable", "internal_error"]}, "message": {"type": "string", "minLength": 1, "maxLength": 200}}, "required": ["code", "message"]}},
      "required": ["error"]
    },
    "PredictionResult": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "transaction_id": {"type": "string", "minLength": 1, "maxLength": 160},
        "risk_score": {"type": "number", "minimum": 0, "maximum": 1},
        "review_status": {"enum": ["review_recommended", "below_threshold"]},
        "source": {"enum": ["fixture", "rules", "model"]},
        "model_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "feature_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "scored_at": {"type": "string", "format": "date-time", "pattern": "Z(?![\\s\\S])"},
        "explanation": {"type": "string", "minLength": 1, "maxLength": 1000}
      },
      "required": ["transaction_id", "risk_score", "review_status", "source", "model_version", "feature_version", "scored_at", "explanation"]
    },
    "Metric": {
      "type": "object", "additionalProperties": false,
      "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 80}, "value": {"type": ["number", "null"]}, "denominator": {"type": "integer", "minimum": 0}, "unit": {"type": "string", "minLength": 1, "maxLength": 40}},
      "required": ["name", "value", "denominator", "unit"]
    },
    "PartitionResults": {
      "type": "object", "additionalProperties": false,
      "properties": {"partition": {"enum": ["train", "validation", "test"]}, "state": {"enum": ["available", "not_authorized", "unavailable"]}, "synthetic_data": {"const": true}, "metrics": {"type": "array", "items": {"$ref": "#/$defs/Metric"}, "maxItems": 40}},
      "required": ["partition", "state", "synthetic_data", "metrics"]
    },
    "ModelResults": {
      "type": "object", "additionalProperties": false,
      "properties": {"model_version": {"type": "string", "minLength": 1, "maxLength": 80}, "feature_version": {"type": "string", "minLength": 1, "maxLength": 80}, "dataset_version": {"type": "string", "minLength": 1, "maxLength": 120}, "threshold": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "calibration_status": {"enum": ["not_assessed", "assessed"]}, "partitions": {"type": "array", "items": {"$ref": "#/$defs/PartitionResults"}, "maxItems": 3}, "limitations": {"type": "array", "items": {"type": "string", "maxLength": 300}, "maxItems": 20}},
      "required": ["model_version", "feature_version", "dataset_version", "threshold", "calibration_status", "partitions", "limitations"]
    },
    "RowCounts": {
      "type": "object", "additionalProperties": false,
      "properties": {"source": {"type": "integer", "minimum": 0}, "accepted": {"type": "integer", "minimum": 0}, "rejected": {"type": "integer", "minimum": 0}, "warmup": {"type": "integer", "minimum": 0}, "scoreable": {"type": "integer", "minimum": 0}},
      "required": ["source", "accepted", "rejected", "warmup", "scoreable"]
    },
    "EdaSeries": {
      "type": "object", "additionalProperties": false,
      "properties": {"series_id": {"type": "string", "minLength": 1, "maxLength": 80}, "label": {"type": "string", "minLength": 1, "maxLength": 120}, "unit": {"enum": ["count", "amount", "transactions_per_day"]}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "timezone": {"const": "UTC"}, "bucket_labels": {"type": "array", "items": {"type": "string", "maxLength": 80}, "maxItems": 366}, "values": {"type": "array", "items": {"type": "number", "minimum": 0}, "maxItems": 366}, "denominator": {"type": "string", "minLength": 1, "maxLength": 200}},
      "required": ["series_id", "label", "unit", "bucket_labels", "values", "denominator"]
    },
    "EdaSummary": {
      "type": "object", "additionalProperties": false,
      "properties": {"dataset_version": {"type": "string", "minLength": 1, "maxLength": 120}, "generated_at": {"type": "string", "format": "date-time", "pattern": "Z(?![\\s\\S])"}, "timezone": {"const": "UTC"}, "row_counts": {"$ref": "#/$defs/RowCounts"}, "quality_counts": {"type": "array", "maxItems": 40, "items": {"type": "object", "additionalProperties": false, "properties": {"category": {"type": "string", "minLength": 1, "maxLength": 80}, "count": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 0}}, "required": ["category", "count", "denominator"]}}, "series": {"type": "array", "items": {"$ref": "#/$defs/EdaSeries"}, "maxItems": 40}},
      "required": ["dataset_version", "generated_at", "timezone", "row_counts", "quality_counts", "series"]
    }
  }
}
